{
  "expo": {
    "name": "Orbit",
    "slug": "orbit-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orbit-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8f6f1"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fiyinadeyera.orbit"
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Orbit uses the microphone so you can capture a note by voice."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Orbit uses your contacts so you can choose people to add to your network."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
