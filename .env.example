# Orbit local environment (copy to .env and fill in real values)
# .env is gitignored. Never commit real keys.

# --- API server ---
# Port the Express API listens on (web/mobile expect 5000)
PORT=5000

# --- Database (Neon hosted Postgres) ---
# Paste your Neon connection string (include ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- AI: note extraction (Anthropic / Claude) ---
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-...

# --- AI: voice transcription + image (OpenAI) ---
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-...

# --- Web dev only (Vite) ---
BASE_PATH=/
